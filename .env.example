# ── Otari (hosted gateway) ───────────────────────────────────
# Get from: https://otari.ai → API keys. Bot key: triage, guard, maintainer runs.
OTARI_API_KEY=otk-your-bot-key
# Get from: https://otari.ai → API keys → New key → Show advanced → "Service key" (enables per-user budgets)
OTARI_SERVICE_KEY=otk-your-service-key
# Get from: https://otari.ai → MCP servers → your GitHub server → id
OTARI_MCP_GITHUB_ID=your-mcp-server-id
# Optional: gateway override (default https://api.otari.ai/api/v1)
# OTARI_BASE_URL=https://api.otari.ai/api/v1

# ── Guardrail endpoint ───────────────────────────────────────
# Generate with: openssl rand -hex 24 — secret path segment of /api/guard/<token>
GUARD_TOKEN=your-random-token

# ── GitHub App ───────────────────────────────────────────────
# Get from: https://github.com/settings/apps → your app → App ID
GITHUB_APP_ID=123456
# Get from: the same page → Private keys → Generate (paste the PEM, newlines as \n)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Get from: the same page → Webhook secret (any random string, also set there)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Optional ─────────────────────────────────────────────────
# Displayed repository pool ceiling in USD (default 5)
# POOL_CEILING_USD=5
# Public base URL used to build the guard URL (default https://allowance.edycu.dev)
# PUBLIC_BASE_URL=https://your-host
# Dry-run CLI only: a GitHub token to read issues
# GITHUB_TOKEN=ghp_your-token
